{
  "name": "hajun-plane-3d",
  "version": "1.0.0",
  "description": "Realistic Jet Airliner 3D Flight Simulator for Web and Flutter WebView",
  "type": "module",
  "scripts": {
    "check": "node scripts/check-syntax.mjs && node scripts/check-workflow-actions.mjs",
    "test": "node --test tests/**/*.test.js",
    "build:core": "node scripts/build_flightsim_core_bundle.mjs",
    "build:info": "node scripts/generate-build-info.mjs",
    "build:geo-tiles": "esbuild scripts/three_core_bundle_source.js --bundle --format=iife --global-name=HajunGeoTiles --outfile=web/js/three_core_bundle.js --target=es2020 --platform=browser && cp web/js/three_core_bundle.js flutter_app/assets/web/js/three_core_bundle.js",
    "wt:new": "node scripts/agent-workflow.mjs wt:new",
    "audio:departure": "node scripts/build-gemini-departure-radio.mjs",
    "audio:check": "node scripts/build-gemini-departure-radio.mjs --check",
    "screens:capture": "node scripts/capture-all-ui-screens.mjs",
    "screens:capture:all": "node scripts/capture-all-ui-screens.mjs --all-viewports",
    "screens:capture:portrait": "node scripts/capture-all-ui-screens.mjs --viewport mobile-portrait",
    "screens:capture:landscape": "node scripts/capture-all-ui-screens.mjs --viewport mobile-landscape",
    "test:ui-screens": "node scripts/capture-all-ui-screens.mjs --tier core --verify",
    "glb:simplify": "node scripts/simplify_glb.mjs",
    "glb:verify": "node scripts/verify_glb.js",
    "build:a320": "node scripts/build_a320_models.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "yaml": "2.8.1"
  },
  "dependencies": {
    "@stlim0727/flightsim-core": "git+https://github.com/stlim0727/flightsim-core.git#0a552c10d14145914f855554b1e5e875310fba44",
    "three": "^0.186.1",
    "3d-tiles-renderer": "^0.5.4"
  }
}
